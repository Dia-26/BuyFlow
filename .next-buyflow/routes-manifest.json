{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/catalog/products/[id]",
      "regex": "^/api/catalog/products/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/catalog/products/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/catalog/products/[id]/complementary",
      "regex": "^/api/catalog/products/([^/]+?)/complementary(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/catalog/products/(?<nxtPid>[^/]+?)/complementary(?:/)?$"
    },
    {
      "page": "/api/catalog/products/[id]/image",
      "regex": "^/api/catalog/products/([^/]+?)/image(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/catalog/products/(?<nxtPid>[^/]+?)/image(?:/)?$"
    },
    {
      "page": "/api/orders/[id]/approve",
      "regex": "^/api/orders/([^/]+?)/approve(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/orders/(?<nxtPid>[^/]+?)/approve(?:/)?$"
    },
    {
      "page": "/api/orders/[id]/checkout-opened",
      "regex": "^/api/orders/([^/]+?)/checkout\\-opened(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/orders/(?<nxtPid>[^/]+?)/checkout\\-opened(?:/)?$"
    },
    {
      "page": "/api/orders/[id]/pay",
      "regex": "^/api/orders/([^/]+?)/pay(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/orders/(?<nxtPid>[^/]+?)/pay(?:/)?$"
    },
    {
      "page": "/api/orders/[id]/payment-failed",
      "regex": "^/api/orders/([^/]+?)/payment\\-failed(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/orders/(?<nxtPid>[^/]+?)/payment\\-failed(?:/)?$"
    },
    {
      "page": "/api/orders/[id]/verify-payment",
      "regex": "^/api/orders/([^/]+?)/verify\\-payment(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/orders/(?<nxtPid>[^/]+?)/verify\\-payment(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}